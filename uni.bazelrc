common --registry=https://raw.githubusercontent.com/nick-dodonov/tx-kit-registry/main
common --registry=https://bcr.bazel.build/

common --enable_platform_specific_config

# try fix "(Segmentation fault): generate-xml.sh failed: error executing TestRunner command"
build --noexperimental_split_xml_generation

#### Workspace status for build info
build:linux --workspace_status_command=uni/tools/build_info/workspace_status.sh
build:macos --workspace_status_command=uni/tools/build_info/workspace_status.sh
build:windows --workspace_status_command=uni/tools/build_info/workspace_status.bat

#### Local tools configuration and specifics
# Local development with preinstalled tools
build:local-path --action_env=PATH
build:local-path --host_action_env=PATH
build:local-tools --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_cmake_toolchain
build:local-tools --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_make_toolchain
build:local-tools --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_ninja_toolchain
build:local-tools --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain

#### Allow building and running platform-specific targets without explicitly specifying the platform
build:multi --@tx-kit-ext//:multi_flag

################################################################
# Windows default setup
# Enable symlinks/runfiles and disable Python zipapp to speed up builds and runners
startup --windows_enable_symlinks
build --build_python_zip=false # building python zip is slow and deprecated
build:windows --enable_runfiles
build:windows --build_runfile_links
# Windows must use local tools because it cannot build them using msvc
build:windows --config=local-path
build:windows --config=local-tools

################################################################
# macOS default setup
# https://bazel.build/run/bazelrc#enable_platform_specific_config
build:macos --macos_sdk_version=26.2
build:macos --action_env=DEVELOPER_DIR
build:macos --host_action_env=DEVELOPER_DIR

################################################################
# WASM default setup
common:wasm --platforms=@emsdk//:platform_wasm
# workaround for strange emsdk behaviour (it uses the same bazel-out/darwin_arm64-dbg/bin/.. as native builds even having different configuration)
common:wasm --platform_suffix=wasm
# WASM boost.asio / boost.container requires pthreads #TODO: patch them
build --features=use_pthreads

################################################################
# Droid default build/run setup
#   must be added to user.post.bazelrc to avoid affecting other users
#   build --config=implicit-droid-* for --config=multi to work (build -droid targets without --platforms setup)
build:implicit-droid-v8a --android_platforms=@rules_android//:arm64-v8a
common:droid-v8a --platforms=@rules_android//:arm64-v8a #--config=implicit-droid-v8a
build:implicit-droid-x64 --android_platforms=@rules_android//:x86_64
common:droid-x64 --platforms=@rules_android//:x86_64 #--config=implicit-droid-x64

################################################################
# Same builds with different PATH
#   Bazel 8 --incompatible_strict_action_env is false, Bazel 9 enables it by default, so prepare for better hermeticity
build --incompatible_strict_action_env

# TODO: resarch how to use node/emsdk/android sdk tools from integrated modules without hardcoding PATH
#  anyway hardcoded PATH is better to setup in user's .bazelrc
build --action_env=PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/rix/Library/Android/sdk/platform-tools"
# build --action_env=JAVA_HOME

# TODO: fix for windows 
#   bazel crashed due to an internal error. Printing stack trace:
#   java.lang.NullPointerException: null value in entry: PATH=null
# run --run_env=PATH
# run --test_env=PATH
# test --test_env=PATH

################################################################
# Suppress deprecation warnings from external dependencies to reduce noise in build output (e.g. protobuf in rules_android)
build --host_per_file_copt=external/.*@-Wno-deprecated-declarations

# Suppress warning w/ rules_java (rules_android)
#   WARNING: A terminally deprecated method in sun.misc.Unsafe has been called
#   WARNING: sun.misc.Unsafe::arrayBaseOffset has been called by com.google.protobuf.UnsafeUtil$MemoryAccessor (file:/private/var/tmp/_bazel_nik/8a8027469951b66e04d265bf023a1ee1/external/rules_java++toolchains+remote_java_tools/java_tools/JavaBuilder_deploy.jar)
startup --host_jvm_args=--sun-misc-unsafe-memory-access=allow

# FIX for cmake build on macOS otherwise "Error: $HOME must be set to run brew."
build --action_env=HOME
# droid runners require ANDROID_HOME to find adb and other tools
test --test_env=ANDROID_HOME

# test --experimental_ui_max_stdouterr_bytes=-1
