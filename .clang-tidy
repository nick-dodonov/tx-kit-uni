---
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-alpha.*,
  bugprone-*,
  -bugprone-exception-escape,
  -bugprone-inc-dec-in-conditions,
  -bugprone-easily-swappable-parameters,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-convert-member-functions-to-static,
  -readability-identifier-length,
  -readability-static-definition-in-anonymous-namespace,
  -readability-uppercase-literal-suffix,
  -readability-math-missing-parentheses,
  -readability-static-accessed-through-instance,
  -readability-named-parameter,
  -readability-isolate-declaration,
  -readability-implicit-bool-conversion


# Disabled checks explanation:
# - alpha.*: Experimental checks, too many false positives
# - bugprone-exception-escape - False positives in codebases that do not use exceptions at all
# - bugprone-inc-dec-in-conditions - False positives in codebases that use i++/i-- in conditions intentionally (e.g. for loops)
# - bugprone-easily-swappable-parameters - False positives in codebases that do not use function overloading at all (e.g. in template solutions, like stdexec::query)
# - cppcoreguidelines-avoid-const-or-ref-data-members: Needed for coroutine promises
# - cppcoreguidelines-avoid-magic-numbers: Acceptable in test code
# - cppcoreguidelines-pro-bounds-*: Sometimes needed for C interop
# - cppcoreguidelines-pro-type-vararg - Do not call c-style vararg functions (printf, etc)
# - cppcoreguidelines-non-private-member-variables-in-classes - Test fixtures often have public member variables for ease of use
# - cppcoreguidelines-avoid-do-while - Common pattern for macros that need to execute multiple statements
# - cppcoreguidelines-avoid-c-arrays - Sometimes needed for C interop
# - cppcoreguidelines-pro-bounds-constant-array-index - Sometimes needed for C interop
# - modernize-use-trailing-return-type: Verbose for simple functions
# - modernize-avoid-c-arrays - Sometimes needed for C interop
# - readability-magic-numbers: Acceptable in test code
# - readability-convert-member-functions-to-static: Breaks coroutine awaiter protocol
# - readability-identifier-length: Conflicts with naming conventions (variable i/j/n are common)
# - readability-static-accessed-through-instance: False positives in codebases that do not use static member variables at all (exec::task<> functions)
# - readability-named-parameter: False positives in codebases that do not use named parameters at all (in template solutions, like stdexec::query)
# - readability-isolate-declaration: False positives in codebases that do not use isolated declarations at all (in template solutions, like stdexec::query)
# - readability-implicit-bool-conversion: False positives in codebases that intentionally use implicit conversions (e.g. if (ptr) instead of if (ptr != nullptr))

CheckOptions:
  #TODO: enable some of these when we have time to fix the warnings
  # - key: readability-identifier-naming.VariableCase
  #   value: camelBack
  # - key: readability-identifier-naming.FunctionCase
  #   value: camelBack
  # - key: readability-identifier-naming.ClassCase
  #   value: CamelCase
  # - key: readability-identifier-naming.MemberCase
  #   value: camelBack
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: 'true'
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: 'true'
  - key: readability-implicit-bool-conversion.AllowLogicalOperatorConversion
    value: 'true'
  # https://clang.llvm.org/extra/clang-tidy/checks/cppcoreguidelines/avoid-non-const-global-variables.html
  - key: cppcoreguidelines-avoid-non-const-global-variables.AllowInternalLinkage
    value: 'true'
  - key: cppcoreguidelines-avoid-non-const-global-variables.AllowThreadLocal
    value: 'true'
  # https://clang.llvm.org/extra/clang-tidy/checks/cppcoreguidelines/special-member-functions.html
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: 'true'

HeaderFilterRegex: '.*'
FormatStyle: file
